[Unit]
Description=GHole DNS resolver and filtering server
Documentation=https://github.com/rkislov/ghole
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghole
Group=ghole
WorkingDirectory=/var/lib/ghole
EnvironmentFile=-/etc/ghole/ghole.env
ExecStart=/usr/bin/ghole -config /var/lib/ghole/config.json -storage sqlite -database /var/lib/ghole/ghole.db
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
StateDirectory=ghole
StateDirectoryMode=0750
RuntimeDirectory=ghole
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ghole
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
