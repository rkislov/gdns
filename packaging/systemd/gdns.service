[Unit]
Description=gdns DNS resolver and filtering server
Documentation=https://github.com/rkislov/gdns
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gdns
Group=gdns
WorkingDirectory=/var/lib/gdns
EnvironmentFile=-/etc/gdns/gdns.env
ExecStart=/usr/bin/gdns -config /var/lib/gdns/config.json -storage sqlite -database /var/lib/gdns/gdns.db
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
StateDirectory=gdns
StateDirectoryMode=0750
RuntimeDirectory=gdns
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gdns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
